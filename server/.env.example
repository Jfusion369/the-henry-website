# The Henry Backend Configuration
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit the actual .env file to version control!

# ===== REQUIRED SECURITY SETTINGS =====

# Admin Credentials
# Username: any string
ADMIN_USERNAME=admin

# Password: MUST be bcrypt-hashed (see instructions below)
# DO NOT use plaintext passwords!
# Generate hash with: npm run hash-password
# Example: $2b$10$N9qo8uLOickgx2ZMRZoMyeIjZAgcg7b3XeKeUxWdeS86E36P4/MdO
HASHED_ADMIN_PASSWORD=$2b$10$your_bcrypt_hash_here_must_be_at_least_60_characters

# JWT Secret: Strong random string (minimum 32 characters)
# Generate with: openssl rand -base64 32
# MUST be set - no default allowed in production!
JWT_SECRET=your-super-secure-jwt-secret-minimum-32-characters-change-this

# ===== REDIS CONFIGURATION =====
# Required for production rate limiting and session management

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== EMAIL CONFIGURATION =====

EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@thehenryllc.com
ADMIN_EMAIL=admin@thehenryllc.com

# ===== DATABASE CONFIGURATION =====

DATABASE_URL=./data/contacts.db

# ===== SERVER CONFIGURATION =====

PORT=3000
NODE_ENV=production

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=https://thehenryllc.com,https://www.thehenryllc.com

# ===== SECURITY NOTES =====
#
# 1. NEVER commit this file to git:
#    - Keep only .env.example in version control
#    - Actual .env should be in .gitignore
#    - Use different values in each environment
#
# 2. Generate JWT_SECRET:
#    Linux/Mac:  openssl rand -base64 32
#    Windows:    [System.Convert]::ToBase64String([System.Security.Cryptography.RNGCryptoServiceProvider]::new().GetBytes(32))
#
# 3. Generate bcrypt password hash:
#    npm run hash-password
#    (You'll be prompted for the password)
#
# 4. Security Best Practices:
#    - Use strong, random passwords (16+ characters)
#    - Rotate credentials quarterly
#    - Monitor Redis connection
#    - Enable HTTPS in production
#    - Set NODE_ENV=production
#    - Use strong Redis password
#    - Keep backups of .env securely
#
# 5. Environment-specific values:
#    Development: Localhost values OK
#    Production:  Use strong, unique secrets
#    Staging:     Mirror production security
#
